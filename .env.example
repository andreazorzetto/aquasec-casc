# Copy to .env and fill in ONE of the sign-in sections. .env is gitignored.
# The tool does not read this file: load it with  set -a; . ./.env; set +a

# --- Self-hosted Aqua: the console's address, user and password --------------------
#AQUA_URL=https://aqua.internal.example
#AQUA_USER=
#AQUA_PASSWORD=
# Leave AQUA_API_ENDPOINT unset here: with it set, the password goes to that endpoint.

# --- SaaS, with an API key (not yet tested against a live tenant) ------------------
#AQUA_API_KEY=
#AQUA_API_SECRET=
#AQUA_API_ENDPOINT=https://eu-1.api.cloudsploit.com
#AQUA_ROLE=api_admin_role
# Optional:
#AQUA_METHODS=ANY:*
# On SaaS, AQUA_URL is optional, and is the console's host, NOT the '-gw' gateway.

# --- TLS: verified by default ------------------------------------------------------
# For an internal CA:
#AQUA_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# Throwaway labs only:
#AQUA_TLS_INSECURE=true

# --- Optional ----------------------------------------------------------------------
# Request timeout, in seconds:
#AQUA_TIMEOUT=30
# Overrides aquasec-casc.yaml:
#AQUASEC_CASC_INSTANCE=platform
