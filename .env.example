# Copy to .env and fill in. .env is gitignored and must stay that way.
# Credentials are read from the environment only -- never from a file in the repo.

# ---------------------------------------------------------------------------
# The Aqua console (REST API) URL. Required for on-prem.
#
# On SaaS this is optional: the console URL is carried in the auth token's
# csp_metadata and resolved automatically. Set it only to override.
#
# Careful: this is the console host, NOT the tenant gateway. The gateway (the
# '-gw' host) speaks gRPC and rejects REST with HTTP 415.
# ---------------------------------------------------------------------------
AQUA_URL=https://your-tenant.cloud.aquasec.com

# ---------------------------------------------------------------------------
# SaaS, API key auth (preferred for CI -- no interactive password).
# Sign-in happens against the regional API endpoint, not the console.
# ---------------------------------------------------------------------------
AQUA_API_KEY=
AQUA_API_SECRET=
AQUA_API_ENDPOINT=https://eu-1.api.cloudsploit.com
AQUA_ROLE=api_admin_role
AQUA_METHODS=ANY

# ---------------------------------------------------------------------------
# On-prem, username/password auth.
# Authenticates against AQUA_URL + /api/v1/login. Leave AQUA_API_ENDPOINT unset.
# ---------------------------------------------------------------------------
#AQUA_USER=
#AQUA_PASSWORD=

# ---------------------------------------------------------------------------
# TLS. On-prem installations commonly use an internal CA. Point this at the CA
# bundle rather than disabling verification -- an air-gapped environment is
# exactly where a verified chain is cheapest to have and most worth having.
# ---------------------------------------------------------------------------
#AQUA_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
