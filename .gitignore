# Credentials -- never, under any circumstances, in this repo.
.env
.env.*
!.env.example
*.pem
*.key
credentials.enc

# Enforcer tokens land in files when running standalone (see spec.tokenSecretRef).
*.token
tokens/

.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

.DS_Store
.idea/
.vscode/

# Aqua's docs and API specs are login-gated vendor content: never commit them
# here. Development uses a separate private knowledge base, read in place; this
# guard catches a copy dropped into the repo by mistake.
reference/
knowledge/
aqua_swagger_*.json
